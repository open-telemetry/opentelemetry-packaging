{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      // Track the per-component upstream version pins in
      // packaging/common/<component>/release.txt. Each file carries a
      // "# renovate: datasource=... depName=..." annotation on the line above
      // the pinned version, which this regex manager parses.
      "customType": "regex",
      "managerFilePatterns": [
        "/packaging/common/[^/]+/release\\.txt$/"
      ],
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+(?<currentValue>\\S+)"
      ]
    },
    {
      // Track the Go toolchain the OBS packages are built with, pinned in
      // .go-version. Renovate has no manager for that file, and none for the
      // go-version of actions/setup-go either, so it is matched here. The
      // version is the whole file, as goenv, mise, and setup-go expect, so
      // the usual "# renovate:" annotation has nowhere to live.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.go-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      // Update github runners used to publish images, which are maintained in packaging/images/config.json.
      "customType": "regex",
      "managerFilePatterns": ["/^packaging/images/config\\.json$/"],
      "matchStrings": [
        "\"runner\"\\s*:\\s*\"(?<depName>[a-z]+)-(?<currentValue>[0-9][0-9a-z.-]*)\""
      ],
      "datasourceTemplate": "github-runners",
      // Docker versioning preserves compatibility suffixes such as "-arm".
      "versioningTemplate": "docker"
    },
    {
      // Track the Tomcat version used by the Java E2E test images. Each
      // Dockerfile carries a "# renovate: datasource=... depName=..."
      // annotation on the line above the ARG holding the version.
      "customType": "regex",
      "managerFilePatterns": ["/^packaging/tests/java/Dockerfile\\.[a-z]+$/"],
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      // Track the uv version the workflows install. The github-actions
      // manager pins the setup-uv action itself, but the version of the uv
      // binary that action downloads is an input it does not read, and an
      // absent input resolves to "latest" on every run. That is the
      // unpinned-tooling failure the Python test pins exist to prevent, with
      // the uv binary in place of pytest.
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "all patch versions",
      "matchUpdateTypes": ["patch"],
      "schedule": ["before 8am every weekday"]
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "schedule": ["before 8am on Monday"]
    },
    {
      // group all GitHub Actions updates into a single weekly PR
      // (Renovate applies packageRules in order and later rules win)
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "before 8am on Tuesday"
      ]
    },
    {
      // The Go toolchain is an input of every package: changing it changes
      // the otel-config-check binary the Python package ships, so an OBS
      // upload commits and releases every component again. Keep it out of
      // the grouped dependency PRs, and together with the go.mod directive
      // it has to stay above, so it can be reviewed and timed on its own.
      "groupName": "go toolchain",
      "matchDatasources": ["golang-version"],
      "schedule": ["before 8am on Monday"]
    },
    {
      // The opentelemetry-python-contrib packages (distro + every
      // instrumentation) are only ever published as PEP 440 pre-releases
      // (e.g. 0.65b0). Renovate treats pre-releases as unstable and skips
      // them by default (ignoreUnstable), so these pins never advance while
      // the stable opentelemetry-sdk (1.x.0) does - leaving the bundle in an
      // inconsistent state. Opt into the pre-release stream and keep the SDK
      // and contrib trains in a single PR so their pins stay mutually
      // consistent.
      "groupName": "opentelemetry-python",
      "matchDatasources": ["pypi"],
      "matchPackageNames": [
        "opentelemetry-sdk",
        "opentelemetry-distro",
        "opentelemetry-instrumentation",
        "opentelemetry-propagator-ot-trace",
        "/^opentelemetry-instrumentation-/"
      ],
      "ignoreUnstable": false
    },
    {
      // The test images fetch Tomcat from dlcdn.apache.org, which only serves
      // current releases; stay on the 10.1 line the tests are written for.
      "matchPackageNames": ["apache/tomcat"],
      "allowedVersions": "/^10\\.1\\./"
    },
    {
      // Keep the image build runners on Ubuntu 24.04. Newer Ubuntu releases
      // are covered by the integration-test matrix in build.yml instead, so
      // a runner bump here would only drop 24.04 coverage.
      "matchFileNames": ["packaging/images/config.json"],
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "/^24\\.04(-arm)?$/"
    }
  ],
  "labels": [
    "dependencies"
  ]
}
