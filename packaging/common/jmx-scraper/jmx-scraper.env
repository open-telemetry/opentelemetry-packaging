## Environment overrides for opentelemetry-jmx-scraper.service.
##
## The unit reads this file with EnvironmentFile=-, so it is optional and the
## unit falls back to its own defaults when it is absent. Restart the service
## after editing it.
##
## systemd reads this file as root before dropping the service to its
## DynamicUser identity, and it is installed mode 0640. Secrets therefore
## belong here rather than in config.properties, which has to stay
## world-readable for the service to read it.

## Path to the scraper configuration. Change this to keep the configuration
## somewhere other than the default location. The file must be readable by the
## service's transient user.
JMX_SCRAPER_CONFIG=/etc/opentelemetry/jmx-scraper/config.properties

## Credentials for a target JVM that requires JMX authentication.
# OTEL_JMX_USERNAME=
# OTEL_JMX_PASSWORD=

## SASL profile for the JMX connection, one of SASL/PLAIN, SASL/DIGEST-MD5,
## SASL/CRAM-MD5, TLS SASL/PLAIN, TLS SASL/DIGEST-MD5, or TLS SASL/CRAM-MD5.
## The DIGEST-MD5 profiles also need a realm.
# OTEL_JMX_REMOTE_PROFILE=
# OTEL_JMX_REALM=

## Headers for the OTLP exporter, which is where an API key would go.
# OTEL_EXPORTER_OTLP_HEADERS=

## The unit resolves "java" through PATH. Set PATH to put a specific JVM first
## when the host has several, or when the JVM to use is not on the system PATH.
# PATH=/opt/myjdk/bin:/usr/bin:/bin
