{{/*
Copyright The OpenTelemetry Authors
SPDX-License-Identifier: Apache-2.0

Template for the spec of one component, rendered by WriteOBSSpec in obsspec.go.
One spec serves both package formats: OBS builds it with debbuild for the DEB repositories and with rpmbuild for the RPM ones, and the vendor macro tells them apart.
Text outside the {{...}} actions is emitted verbatim, so this file reads as the spec it produces.

Both builders expand macros in comments, so the comments below name spec sections and macros without a leading percent sign.
This matters most to rpm: a section macro in a comment above the preamble makes rpm 4.16 (EL9) start that section mid-comment and swallow the preamble.
*/ -}}
# Copyright The OpenTelemetry Authors
# SPDX-License-Identifier: Apache-2.0
#
# Generated by "build-spec/obs" from packaging/builder. DO NOT EDIT.
#
# Built on the Open Build Service, whose builds have no network access, by debbuild for the DEB repositories and by rpmbuild for the RPM ones.
# The payload is therefore staged ahead of time, by the same builder that produces the nfpm packages, into the source archive: one tree per architecture, next to a file list for each package format.
# This spec builds nothing and only copies the tree for the architecture being built.
#
# The few differences between the two builders sit under a test of the vendor macro: it is "debbuild" for debbuild, and anything else is rpm.
#
# There is no changelog section on purpose: the repository history is the changelog, and a generated spec has no stable date to put there.

%if "%{_vendor}" == "debbuild"
# The dependencies are declared below, as in the nfpm packages.
# Without this, debbuild would add every shared library the bundled agents link against.
AutoReq:        no

# debbuild creates the package's directories itself, and recompresses man pages after the install section, under the umask of the build, which is 002 on the Open Build Service: the package would ship group-writable directories.
# These two commands are what it runs for both, so they set the umask nfpm packages with instead.
%global __mkdir_p umask 022 && /bin/mkdir -p
%global __gzip umask 022 && /bin/gzip

%global filelist {{ .DebFileList }}
{{ if .Noarch -}}
%global payload_arch {{ .PayloadDir }}
{{ else -}}
%global payload_arch %{_arch}
{{ end -}}
{{ if .DebArchs }}%global payload_archs {{ .DebArchs }}
{{ end -}}
%else
# The bundled agents are prebuilt binaries: no stripping, no debuginfo, and no build-id links.
# The payload must also reach the package byte for byte as it is in the source archive, which is what the DEB packages ship.
# Two post-install scripts rewrite files in the buildroot unless switched off: brp-mangle-shebangs, which turns "#!/usr/bin/env node" into "#!/usr/bin/node" and so breaks the scripts on a host whose node is elsewhere, and brp-python-bytecompile, which would write unpackaged __pycache__ files.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __brp_mangle_shebangs %{nil}
%global __brp_python_bytecompile %{nil}

# This spec carries no changelog, so there is no date in it to derive SOURCE_DATE_EPOCH from.
# Saying so is better than fabricating an entry to satisfy the macro, which would otherwise warn on every build.
%global source_date_epoch_from_changelog 0

# Keep the bundled libraries private: rpm would otherwise publish the injector's SONAME as "Provides: libinjector.so()(64bit)", which could satisfy an unrelated package.
# Safe to filter, as the injector is preloaded by absolute path and never resolved by SONAME.
# Requires generation stays on: the glibc symbol versions are real install constraints.
# The pattern matches /usr/lib, where these packages install on every architecture, not /usr/lib64.
%global __provides_exclude_from ^%{_prefix}/lib/opentelemetry/.*$

# The agents instrument the runtime the application already has, so a dependency on one is wrong: on EL 9 it resolves to a nodejs older than the bundled agent supports.
# The DEB packages declare none either.
# Filtered by dependency rather than by path, which would drop the glibc symbol versions too.
%global __requires_exclude ^%{_bindir}/(node|python3)$

%global filelist {{ .RPMFileList }}
{{ if .Noarch -}}
%global payload_arch {{ .PayloadDir }}
{{ else -}}
# The source archive names each payload after its DEB architecture.
%ifarch x86_64
%global payload_arch amd64
%endif
%ifarch aarch64
%global payload_arch arm64
%endif
{{ if .RPMArchs }}%global payload_archs {{ .RPMArchs }}
{{ end -}}
{{ end -}}
%endif

Name:           {{ .Name }}
Version:        {{ .Version }}
Release:        {{ .Release }}
Summary:        {{ .Summary }}
%if "%{_vendor}" == "debbuild"
# debbuild writes the Group tag out as the DEB Section field, and omits the field entirely when the tag is absent; the Packager tag becomes the Maintainer field. rpm needs neither.
Group:          {{ .Section }}
Packager:       {{ .Packager }}
%endif
License:        {{ .License }}
URL:            {{ .URL }}
Source0:        %{name}-%{version}.tar.gz
{{ if .Noarch }}BuildArch:      noarch
{{ end -}}
{{ range .Provides }}Provides:       {{ . }}
{{ end -}}
{{ range .Requires }}Requires:       {{ . }}
{{ end -}}
{{ range .Recommends }}Recommends:     {{ . }}
{{ end -}}
{{ range .Suggests }}Suggests:       {{ . }}
{{ end -}}
{{ range .Conflicts }}Conflicts:      {{ . }}
{{ end -}}
{{ if .Replaces -}}
%if "%{_vendor}" == "debbuild"
{{ range .Replaces }}Replaces:       {{ . }}
{{ end -}}
%else
{{ range .Replaces }}Obsoletes:      {{ . }}
{{ end -}}
%endif
{{ end }}
{{ if .DebArchs -}}
# The source archive carries a payload for the architectures below, and the install and files sections below pick the one the architecture names.
# A build for any other architecture would otherwise fail in the install section, where debbuild discards the output of every section it runs, leaving only an "Exec of /var/tmp/deb-tmp.install.NNN failed" line and the status 512 to go on.
# Catching it here instead fails while the spec is read, where the message is printed.
%ifnarch %{payload_archs}
%{error:this package is built for %{payload_archs}, not %{_arch}}
%endif

{{ end -}}
%description
{{ .Description }}

%prep
# Creates the build directory without unpacking into it, and takes only the file list from the archive.
# The payload does not belong here: the install section extracts it straight from the archive, and the build directory is only where the files section reads its list from.
# Unpacking the archive whole would write out every architecture's payload to use one.
%setup -q -c -T
tar -xzf %{SOURCE0} --strip-components=1 \
    %{name}-%{version}/%{payload_arch}/%{filelist}

%build
# Nothing to build: the payload in the source archive is already staged.

%install
# Extracted from the archive again rather than copied from the setup tree, whose modes the build user's umask has already narrowed.
# The file list declares no modes for a DEB, so the archive is where they come from.
mkdir -p %{buildroot}
tar -xzpf %{SOURCE0} -C %{buildroot} --strip-components=3 \
    %{name}-%{version}/%{payload_arch}/root

{{ range .Scriptlets }}%{{ .Section }}
{{ .Body }}

{{ end -}}
%files -f %{payload_arch}/%{filelist}
