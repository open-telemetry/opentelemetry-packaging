# Copyright The OpenTelemetry Authors
# SPDX-License-Identifier: Apache-2.0
#
# Generated by "build-packages -format spec" from packaging/builder. DO NOT EDIT.
#
# The package metadata below is a projection of packaging/builder/components.go,
# and the file lists are generated during the install section by the same
# builder, so neither can drift from the packages nfpm produces.
#
# There is no changelog section on purpose: the repository history is the
# changelog, and a generated spec has no stable date to put there.
#
# Comments here name spec sections without a leading percent sign on purpose:
# rpm expands macros inside comments too, and an unescaped section macro in a
# comment above the preamble makes rpm 4.16 (EL9) start that section mid-comment
# and swallow the preamble.

# The bundled agents are prebuilt binaries: no stripping, no debuginfo, and no
# build-id links.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none

# This spec carries no changelog, so there is no date in it to derive
# SOURCE_DATE_EPOCH from. Saying so is better than fabricating an entry to
# satisfy the macro, which would otherwise warn on every build.
%global source_date_epoch_from_changelog 0

# Keep the bundled libraries private: rpm would otherwise publish the injector's
# SONAME as "Provides: libinjector.so()(64bit)", which could satisfy an unrelated
# package. Safe to filter, as the injector is preloaded by absolute path and
# never resolved by SONAME. Requires generation stays on: the glibc symbol
# versions are real install constraints. The pattern matches /usr/lib, where
# these packages install on every architecture, not /usr/lib64.
%global __provides_exclude_from ^%{_prefix}/lib/opentelemetry/.*$

# The agents instrument the runtime the application already has, so a dependency
# on one is wrong: on EL 9 it resolves to a nodejs older than the bundled agent
# supports. The DEB packages declare none either. Filtered by dependency rather
# than by path, which would drop the glibc symbol versions too.
%global __requires_exclude ^%{_bindir}/(node|python3)$

%ifarch x86_64
%global otel_arch amd64
%endif
%ifarch aarch64
%global otel_arch arm64
%endif

# The bundled Python wheels carry compiled extensions for one CPython ABI, so
# the Python package is only built where that ABI matches the distribution
# interpreter. Fedora tracks a current CPython; the EPEL chroots do not.
%if 0%{?fedora}
%global with_python 1
%else
%global with_python 0
%endif

Name:           {{ .Name }}
Version:        {{ .Version }}
Release:        {{ .Release }}
Summary:        {{ .Summary }}
License:        {{ .License }}
URL:            {{ .URL }}
Source0:        %{name}-%{version}.tar.gz

# The packaging supports these two architectures only.
ExclusiveArch:  {{ .ExclusiveArch }}

{{ range .BuildRequires }}BuildRequires:  {{ . }}
{{ end }}
%description
Source package for the OpenTelemetry auto-instrumentation suite. It builds the
LD_PRELOAD injector, the language auto-instrumentation packages, and the
metapackage that ties them together. This package ships no files itself.

{{ range .Packages }}
{{- if .Guarded }}{{ $.PythonGuard }}
{{ end -}}
%package -n {{ .Name }}
Summary:        {{ .Summary }}
{{ if .Noarch }}BuildArch:      noarch
{{ end -}}
{{ range .Provides }}Provides:       {{ . }}
{{ end -}}
{{ range .Requires }}Requires:       {{ . }}
{{ end -}}
{{ range .Recommends }}
{{- if .Guarded }}{{ $.PythonGuard }}
Recommends:     {{ .Name }}
%endif
{{ else }}Recommends:     {{ .Name }}
{{ end -}}
{{ end -}}
{{ range .Suggests }}Suggests:       {{ . }}
{{ end }}
%description -n {{ .Name }}
{{ .Description }}

{{ if .Guarded }}%endif

{{ end }}
{{- end -}}
%prep
%autosetup -n %{name}-%{version}

%build
# Built from the vendored module cache in the source tarball, so the buildroot
# needs no network access for the Go dependencies.
export CGO_ENABLED=0
export GOFLAGS="-mod=vendor"
# Certain Fedora versions ship old version of Go + sets GOTOOLCHAIN=local.
# Override that to automatically download relevant Go version on build.
export GOTOOLCHAIN=auto
go build -trimpath -o build/bin/build-packages ./cmd/build-packages
go build -trimpath -o build/bin/otel-config-check ./cmd/otel-config-check

%install
# The payload is staged by the same builder that produces the nfpm packages, and
# it writes one file list per component alongside it. Nothing here runs as root,
# so nothing may change file ownership: the attr directives in the fragments
# assign root:root at packaging time instead.
mkdir -p %{_builddir}/filelists

stage() {
    build/bin/build-packages \
        -stage-root %{buildroot} \
        -filelist-dir %{_builddir}/filelists \
        -component "$1" \
        -version %{version} \
        -arch %{otel_arch} \
        -config-check-binary build/bin/otel-config-check
}

for component in {{ .UnguardedComponents }}; do
    stage "$component"
done
{{ range .GuardedComponents }}
{{ $.PythonGuard }}
stage {{ . }}
%endif
{{ end }}
{{ range .Scriptlets }}%{{ .Section }} -n {{ .PackageName }}
{{ .Body }}

{{ end -}}
{{ range .Packages }}
{{- if .Guarded }}{{ $.PythonGuard }}
{{ end -}}
%files -n {{ .Name }} -f %{_builddir}/filelists/{{ .Component }}.files

{{ if .Guarded }}%endif

{{ end -}}
{{ end -}}
