{{/*
Copyright The OpenTelemetry Authors
SPDX-License-Identifier: Apache-2.0

Template for the debbuild spec of one component, rendered by WriteDebSpec in
debspec.go. Text outside the {{...}} actions is emitted verbatim, so this file
reads as the spec it produces.

debbuild expands macros in comments as rpm does, so the comments below name
spec sections and macros without a leading percent sign.
*/ -}}
# Copyright The OpenTelemetry Authors
# SPDX-License-Identifier: Apache-2.0
#
# Generated by "build-spec/deb" from packaging/builder. DO NOT EDIT.
#
# Built by debbuild on the Open Build Service, whose builds have no network
# access. The payload is therefore staged ahead of time, by the same builder
# that produces the nfpm packages, into the source archive: one tree per DEB
# architecture, next to the file list written for it. This spec builds nothing
# and only copies the tree for the architecture being built.
#
# There is no changelog section on purpose: the repository history is the
# changelog, and a generated spec has no stable date to put there.

# The dependencies are declared below, as in the nfpm packages. Without this,
# debbuild would add every shared library the bundled agents link against.
AutoReq:        no

# debbuild creates the package's directories itself, and recompresses man pages
# after the install section, under the umask of the build, which is 002 on the
# Open Build Service: the package would ship group-writable directories. These
# two commands are what it runs for both, so they set the umask nfpm packages
# with instead.
%global __mkdir_p umask 022 && /bin/mkdir -p
%global __gzip umask 022 && /bin/gzip

Name:           {{ .Name }}
Version:        {{ .Version }}
Release:        {{ .Release }}
Summary:        {{ .Summary }}
# debbuild writes the Group tag out as the DEB Section field, and omits the
# field entirely when the tag is absent.
Group:          {{ .Section }}
License:        {{ .License }}
URL:            {{ .URL }}
Packager:       {{ .Packager }}
Source0:        %{name}-%{version}.tar.gz
{{ if .Noarch }}BuildArch:      noarch
{{ end -}}
{{ range .Provides }}Provides:       {{ . }}
{{ end -}}
{{ range .Requires }}Requires:       {{ . }}
{{ end -}}
{{ range .Recommends }}Recommends:     {{ . }}
{{ end -}}
{{ range .Suggests }}Suggests:       {{ . }}
{{ end -}}
{{ range .Conflicts }}Conflicts:      {{ . }}
{{ end -}}
{{ range .Replaces }}Replaces:       {{ . }}
{{ end }}
%description
{{ .Description }}

%prep
%setup -q

%build
# Nothing to build: the payload in the source archive is already staged.

%install
# Extracted from the archive again rather than copied from the setup tree,
# whose modes the build user's umask has already narrowed. The file list
# declares no modes, so the archive is where they come from.
mkdir -p %{buildroot}
tar -xzpf %{SOURCE0} -C %{buildroot} --strip-components=3 \
    %{name}-%{version}/{{ .PayloadDir }}/root

{{ range .Scriptlets }}%{{ .Section }}
{{ .Body }}

{{ end -}}
%files -f {{ .PayloadDir }}/{{ .Component }}.files
